---
import videos from '../../data/videos.json';

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { id: video.id },
    props: { video },
  }));
}

const { video } = Astro.props;
---
<html lang="hi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{video.title} - Dhamtan TV</title>
  <meta name="description" content={video.title} />
  <style>
    body { font-family: sans-serif; margin: 0; padding: 20px; background: #000; color: white; }
    .container { max-width: 900px; margin: 0 auto; }
    iframe { width: 100%; height: 460px; border: 0; border-radius: 10px; background: #111; }
    a { color: #ff4757; text-decoration: none; display: inline-block; margin-bottom: 16px; }
  </style>
</head>
<body>
  <div class="container">
    <a href="/">← Back</a>
    <h1>{video.title}</h1>
    <iframe src={`https://www.dailymotion.com/embed/video/${video.id}`} allowfullscreen></iframe>
  </div>
</body>
</html>
