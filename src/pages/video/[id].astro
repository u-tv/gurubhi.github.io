---
import videos from '../../data/videos.json';

export async function getStaticPaths() {
  return videos.map((video) => ({
    params: { id: video.id },
    props: { video },
  }));
}

const { video } = Astro.props;
---
<html lang="hi">
<head>
    <meta charset="utf-8" />
    <title>{video.title} - Watch Online on Dhamtan TV</title>
    <meta name="description" content={`Watch full video ${video.title} online on Dhamtan TV platform.`} />
    <meta property="og:title" content={video.title} />
    <meta property="og:image" content={video.thumbnail_url} />
    <style>
        body { font-family: sans-serif; margin: 0; padding: 20px; background: #000; color: white; text-align: center; }
        .container { max-width: 800px; margin: 0 auto; }
        iframe { width: 100%; height: 450px; border: none; margin-top: 20px; background: #111; border-radius: 8px; }
        a { color: #ff4757; text-decoration: none; display: inline-block; margin-bottom: 20px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <a href="/">← Back to Home</a>
        <h1>{video.title}</h1>
        <iframe src={`https://dailymotion.com{video.id}?autoplay=0`} allowfullscreen></iframe>
    </div>
</body>
</html>
