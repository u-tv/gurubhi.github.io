---
import videos from '../data/videos.json';
---
<html lang="hi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dhamtan TV</title>
</head>
<body>
  <h1>Dhamtan TV</h1>
  <div>
    {videos?.length ? videos.map((video) => (
      <div><a href={`/video/${video.id}`}>{video.title}</a></div>
    )) : <p>No videos found</p>}
  </div>
</body>
</html>
